<Window x:Class="PlanoOpenSpaceIT.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plano Open Space IT" Width="1400" Height="900" MinWidth="900" MinHeight="460"
        AutomationProperties.AutomationId="PlanoOpenSpaceIT.MainWindow">
    <Grid>
        <wv2:WebView2 x:Name="Browser"
                      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                      AutomationProperties.AutomationId="PlanoOpenSpaceIT.WebView"
                      AutomationProperties.Name="Contenido de la aplicación Plano Open Space IT" />
        <Border x:Name="AuditLogWarning" Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16" Padding="12,8" Visibility="Collapsed" IsHitTestVisible="False"
                Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1"
                AutomationProperties.AutomationId="PlanoOpenSpaceIT.AuditLogWarning" AutomationProperties.LiveSetting="Assertive">
            <TextBlock Text="La auditoría no está disponible. Los cambios se guardarán, pero no se podrán registrar hasta que se recupere el acceso."
                       TextWrapping="Wrap" MaxWidth="640" Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" />
        </Border>
        <Border x:Name="ErrorPanel" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Padding="32" Visibility="Collapsed" Focusable="True"
                AutomationProperties.AutomationId="PlanoOpenSpaceIT.ErrorPanel">
            <StackPanel MaxWidth="680">
                <TextBox x:Name="ErrorText" IsReadOnly="True" TextWrapping="Wrap" FontSize="16" BorderThickness="0" Background="Transparent"
                         AutomationProperties.LiveSetting="Assertive" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="RetryButton" Padding="14,7" Click="OnRetry">Reintentar</Button>
                    <Button x:Name="OpenLogsButton" Margin="10,0,0,0" Padding="14,7" Click="OnOpenLogs">Abrir carpeta de logs</Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
